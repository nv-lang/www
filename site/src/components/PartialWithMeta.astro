---
// PartialWithMeta — рендер рукописного партиала с PageMeta между <main> и
// футером (план www-06, полировка 2026-08-02): у рукописных страниц футер
// зашит в сам партиал, поэтому слот page-meta после body оказывался ПОД
// футером сайта. Блок вставляется перед <footer> партиала, впритык к нему
// (стыковка — .page-meta-outer + .site-footer в global.css). Партиал без
// <footer> получает блок в конце, как раньше.
import PageMeta from './PageMeta.astro';

interface Props {
  body: string;
  lang: 'ru' | 'en';
  pagePath: string;
  editUrl?: string;
  sourceUrl?: string;
  partialUrl?: string;
  sourceDate?: string;
}

const { body, ...metaProps } = Astro.props;
const idx = body.lastIndexOf('<footer');
const before = idx >= 0 ? body.slice(0, idx) : body;
const after = idx >= 0 ? body.slice(idx) : '';
---

<Fragment set:html={before} />
<div class="container--narrow page-meta-outer">
  <PageMeta {...metaProps} />
</div>
<Fragment set:html={after} />
