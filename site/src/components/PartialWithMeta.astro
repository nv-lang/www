---
// PartialWithMeta — рендер рукописного партиала с PageMeta ВНУТРИ <main>
// (план 241, полировка 2026-08-02): у рукописных страниц футер зашит в сам
// партиал, поэтому слот page-meta после body оказывался ПОД футером сайта.
// Здесь блок вставляется перед закрывающим </main> — над футером, в ширину
// контентной колонки. Партиал без </main> рендерится как раньше (блок после).
import PageMeta from './PageMeta.astro';

interface Props {
  body: string;
  lang: 'ru' | 'en';
  pagePath: string;
  editUrl?: string;
  sourceUrl?: string;
  partialUrl?: string;
  sourceDate?: string;
}

const { body, ...metaProps } = Astro.props;
const idx = body.lastIndexOf('</main>');
const before = idx >= 0 ? body.slice(0, idx) : body;
const after = idx >= 0 ? body.slice(idx) : '';
---

<Fragment set:html={before} />
{idx >= 0 ? (
  <div class="container--narrow">
    <PageMeta {...metaProps} />
  </div>
) : null}
<Fragment set:html={after} />
{idx < 0 ? <PageMeta {...metaProps} /> : null}
