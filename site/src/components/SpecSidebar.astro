---
// Единая боковая навигация раздела /spec/ — обзорные документы,
// решения (D-блоки) и история. current: 'spec:<slug>' для документа,
// 'dec:index' / 'dec:<topic>' для страниц решений.
import { TOPICS } from '@data/decisions';
import { SPEC_DOCS } from '@data/spec';

interface Props {
  current?: string;
  lang?: 'ru' | 'en';
}
// 241 Ф.2: на английских страницах спеки меню обязано быть английским, а
// ссылки — вести в английские маршруты; русская сторона живёт под /ru/.
const { current, lang = 'ru' } = Astro.props;
const ru = lang === 'ru';
const base = ru ? '/ru/spec' : '/spec';
const t = (o: { title: string; titleEn?: string }) => (ru ? o.title : (o.titleEn ?? o.title));

const guide = SPEC_DOCS.filter((d) => d.group === 'guide' && d.slug !== 'open-questions');
const extra = SPEC_DOCS.filter((d) => d.group === 'history' || d.slug === 'open-questions');
---

<aside class="doc-sidebar">
  <div class="sidebar-section">
    <div class="sidebar-section__title">{ru ? 'Спецификация' : 'Specification'}</div>
    <ul>
      <li>
        <a href={`${base}/`} class={current === 'index' ? 'active' : undefined}>{ru ? 'Обзор раздела' : 'Section overview'}</a>
      </li>
      {guide.map((d) => (
        <li>
          <a href={`${base}/${d.slug}/`} class={current === `spec:${d.slug}` ? 'active' : undefined}>
            {t(d)}
          </a>
        </li>
      ))}
    </ul>
  </div>

  <div class="sidebar-section">
    <div class="sidebar-section__title">{ru ? 'Решения (D-блоки)' : 'Design decisions'}</div>
    <ul>
      <li>
        <a href={`${base}/decisions/`} class={current === 'dec:index' ? 'active' : undefined}>
          {ru ? 'Все D-блоки' : 'All D-blocks'}
        </a>
      </li>
      {TOPICS.map((topic) => (
        <li>
          <a href={`${base}/decisions/${topic.slug}/`} class={current === `dec:${topic.slug}` ? 'active' : undefined}>
            {t(topic)}
          </a>
        </li>
      ))}
    </ul>
  </div>

  <div class="sidebar-section">
    <div class="sidebar-section__title">{ru ? 'Ещё' : 'More'}</div>
    <ul>
      {extra.map((d) => (
        <li>
          <a href={`${base}/${d.slug}/`} class={current === `spec:${d.slug}` ? 'active' : undefined}>
            {t(d)}
          </a>
        </li>
      ))}
      <li><a href="https://github.com/nv-lang/nova/tree/main/spec">Источник на GitHub &#8599;</a></li>
    </ul>
  </div>
</aside>
