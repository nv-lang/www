---
import { getCollection, render } from 'astro:content';
import BaseLayout from '@layouts/BaseLayout.astro';
import SpecSidebar from '@components/SpecSidebar.astro';
import PageMeta from '@components/PageMeta.astro';
import { SPEC_DOCS } from '@data/spec';

export async function getStaticPaths() {
  const entries = await getCollection('spec');
  return SPEC_DOCS.map((doc) => ({
    params: { slug: doc.slug },
    props: { entry: entries.find((e) => e.id === doc.id)!, doc },
  }));
}

const { entry, doc } = Astro.props;
const { Content } = await render(entry);
const ghUrl = `https://github.com/nv-lang/nova/blob/main/${doc.github}`;
const sourcePath = entry.data.sourcePath;
const sourceUrl = sourcePath
  ? `https://github.com/nv-lang/nova/blob/main/${sourcePath}`
  : ghUrl;
---

<BaseLayout
  title={`${doc.title} — спецификация — Nova`}
  description={`${doc.title} — раздел спецификации языка Nova.`}
  canonical={`https://nv-lang.org/spec/${doc.slug}/`}
  lang="ru"
  active={doc.slug === 'syntax' ? 'syntax' : 'spec'}
>
  <div class="doc-layout">
    <SpecSidebar current={`spec:${doc.slug}`} />
    <main id="main-content">
      <div class="spec-doc__meta">
        <a href="/spec/">&#8592; Спецификация</a>
        <a href={ghUrl}>Источник на GitHub &#8599;</a>
      </div>
      <p class="spec-lang-note">The specification is currently maintained in Russian only.</p>
      <article class="doc-content">
        <Content />
      </article>
      <PageMeta
        lang="ru"
        pagePath={`/spec/${doc.slug}/`}
        sourceUrl={sourceUrl}
        sourceDate={entry.data.sourceDate}
      />
    </main>
  </div>
</BaseLayout>
