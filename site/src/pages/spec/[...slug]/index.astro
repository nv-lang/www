---
import { getCollection, render } from 'astro:content';
import BaseLayout from '@layouts/BaseLayout.astro';
import SpecSidebar from '@components/SpecSidebar.astro';
import PageMeta from '@components/PageMeta.astro';
import { SPEC_DOCS } from '@data/spec';

export async function getStaticPaths() {
  const entries = await getCollection('spec');
  // 241 Ф.2: английская страница берёт перевод spec/<slug>.en.md, если он
  // есть; иначе — fallback на русский норматив с честной пометкой (страница
  // не должна исчезать из-за отсутствия перевода).
  return SPEC_DOCS.map((doc) => {
    const en = entries.find((e) => e.id === `en/${doc.id}`);
    const ru = entries.find((e) => e.id === doc.id)!;
    return {
      params: { slug: doc.slug },
      props: { entry: en ?? ru, doc, translated: Boolean(en) },
    };
  });
}

const { entry, doc, translated } = Astro.props;
const title = translated ? (doc.titleEn ?? doc.title) : doc.title;
const { Content } = await render(entry);
const ghUrl = `https://github.com/nv-lang/nova/blob/main/${doc.github}`;
const sourcePath = entry.data.sourcePath;
const sourceUrl = sourcePath
  ? `https://github.com/nv-lang/nova/blob/main/${sourcePath}`
  : ghUrl;
---

<BaseLayout
  title={`${title} — specification — Nova`}
  description={`${title} — a section of the Nova language specification.`}
  canonical={`https://nv-lang.org/spec/${doc.slug}/`}
  lang="en"
  hreflangRu={`https://nv-lang.org/ru/spec/${doc.slug}/`}
  hreflangEn={`https://nv-lang.org/spec/${doc.slug}/`}
  langRuUrl={`/ru/spec/${doc.slug}/`}
  langEnUrl={`/spec/${doc.slug}/`}
  active={doc.slug === 'syntax' ? 'syntax' : 'spec'}
>
  <div class="doc-layout">
    <SpecSidebar lang="en" current={`spec:${doc.slug}`} />
    <main id="main-content">
      <div class="spec-doc__meta">
        <a href="/spec/">&#8592; Specification</a>
        <a href={ghUrl}>Source on GitHub &#8599;</a>
      </div>
      {translated
        ? <p class="spec-lang-note">Informative translation. The Russian text (<a href={`/ru/spec/${doc.slug}/`}>русский оригинал</a>) is normative.</p>
        : <p class="spec-lang-note">This page is not translated yet — the normative Russian text is shown.</p>}
      <article class="doc-content">
        <Content />
      </article>
      <PageMeta
        lang="en"
        pagePath={`/spec/${doc.slug}/`}
        sourceUrl={sourceUrl}
        sourceDate={entry.data.sourceDate}
      />
    </main>
  </div>
</BaseLayout>
