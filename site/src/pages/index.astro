---
import BaseLayout from '@layouts/BaseLayout.astro';
import PartialWithMeta from '@components/PartialWithMeta.astro';
import body from '@partials/en-index.html?raw';
import { partialDate } from '@data/sourceMeta';
const updated = partialDate('en-index.html');
const meta = {
  title: "Nova — a systems language with effects, contracts, and M:N runtime",
  description: "Nova is a general-purpose systems language built around algebraic effects, static contracts, and an M:N concurrency runtime. Designed for correctness and clarity.",
  canonical: "https://nv-lang.org/",
  lang: "en" as const,
  hreflangRu: "https://nv-lang.org/ru/",
  hreflangEn: "https://nv-lang.org/",
  hreflangXDefault: "https://nv-lang.org/",
  ogType: "website",
  ogUrl: "https://nv-lang.org/",
  ogTitle: "Nova — systems language with effects and contracts",
  ogDescription: "A general-purpose systems language built around algebraic effects, static contracts, and an M:N concurrency runtime.",
  twitterTitle: "Nova — systems language with effects and contracts",
  twitterDescription: "A general-purpose systems language built around algebraic effects, static contracts, and an M:N concurrency runtime.",
  langRuUrl: "/ru/",
  langEnUrl: "/",
};
---

<BaseLayout {...meta} active="home" jsonLd={true}>
  <PartialWithMeta
    body={body}
    lang="en"
    pagePath="/"
    partialUrl="https://github.com/nv-lang/www/blob/main/site/src/partials/en-index.html"
    sourceDate={updated}
  />
</BaseLayout>
