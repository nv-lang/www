---
import BaseLayout from '@layouts/BaseLayout.astro';
import body from '@partials/ru-release-index.html?raw';
import headExtra from '@partials/ru-release-index-head.html?raw';
const meta = {
  title: "Nova Oracle 0.1.0 и Carina 0.2.1 — Релизы",
  description: "Альфа-выпуски: Oracle для Windows и Linux и принятая самосборочная Carina для Windows x86_64.",
  canonical: "https://nv-lang.org/ru/release/",
  lang: "ru" as const,
  hreflangRu: "https://nv-lang.org/ru/release/",
  hreflangEn: "https://nv-lang.org/release/",
  hreflangXDefault: "https://nv-lang.org/release/",
  ogType: "website",
  ogUrl: "https://nv-lang.org/ru/release/",
  ogTitle: "Nova Oracle 0.1.0 и Carina 0.2.1 — Релизы",
  ogDescription: "Альфа-выпуски: Oracle для Windows и Linux, Carina 0.2 с самосборкой на Windows x86_64.",
  twitterTitle: "Nova Oracle 0.1.0 и Carina 0.2.1 — Релизы",
  twitterDescription: "Альфа-выпуски: Oracle для Windows и Linux, Carina 0.2 с самосборкой на Windows x86_64.",
  langRuUrl: "/ru/release/",
  langEnUrl: "/release/",
};
---

<BaseLayout {...meta} active={undefined}>
  <Fragment slot="head-extra" set:html={headExtra} />
  <Fragment set:html={body} />
</BaseLayout>
