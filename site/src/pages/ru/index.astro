---
import BaseLayout from '@layouts/BaseLayout.astro';
import PageMeta from '@components/PageMeta.astro';
import body from '@partials/index.html?raw';
import { partialDate } from '@data/sourceMeta';
const updated = partialDate('index.html');
const meta = {
  title: "Nova — язык с эффектами, контрактами и M:N рантаймом",
  description: "Nova — язык системного уровня на основе алгебраических эффектов, статических контрактов и M:N рантайма. Каждый побочный эффект объявлен. Каждый инвариант проверяется.",
  canonical: "https://nv-lang.org/ru/",
  lang: "ru" as const,
  hreflangRu: "https://nv-lang.org/ru/",
  hreflangEn: "https://nv-lang.org/",
  hreflangXDefault: "https://nv-lang.org/",
  ogType: "website",
  ogUrl: "https://nv-lang.org/ru/",
  ogTitle: "Nova — язык с эффектами и контрактами",
  ogDescription: "Язык системного уровня на основе алгебраических эффектов, статических контрактов и M:N рантайма.",
  twitterTitle: "Nova — язык с эффектами, контрактами и M:N рантаймом",
  twitterDescription: "Nova — язык системного уровня на основе алгебраических эффектов, статических контрактов и M:N рантайма. Каждый побочный эффект объявлен. Каждый инвариант проверяется.",
  langRuUrl: "/ru/",
  langEnUrl: "/",
};
---

<BaseLayout {...meta} active="home" jsonLd={true}>
  <Fragment set:html={body} />
  <PageMeta
    lang="ru"
    pagePath="/ru/"
    partialUrl="https://github.com/nv-lang/www/blob/main/site/src/partials/index.html"
    sourceDate={updated}
  />
</BaseLayout>
