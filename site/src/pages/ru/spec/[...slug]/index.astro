---
import { getCollection, render } from 'astro:content';
import BaseLayout from '@layouts/BaseLayout.astro';
import SpecSidebar from '@components/SpecSidebar.astro';
import PageMeta from '@components/PageMeta.astro';
import { SPEC_DOCS } from '@data/spec';

export async function getStaticPaths() {
  const entries = await getCollection('spec');
  // 241 Ф.2: английская страница берёт перевод spec/<slug>.en.md, если он
  // есть; иначе — fallback на русский норматив с честной пометкой (страница
  // не должна исчезать из-за отсутствия перевода).
  // Русская сторона: ВСЕГДА нормативный текст, без fallback.
  return SPEC_DOCS.map((doc) => ({
    params: { slug: doc.slug },
    props: { entry: entries.find((e) => e.id === doc.id)!, doc, translated: false },
  }));
}

const { entry, doc, translated } = Astro.props;
const title = doc.title;
const { Content } = await render(entry);
const ghUrl = `https://github.com/nv-lang/nova/blob/main/${doc.github}`;
const sourcePath = entry.data.sourcePath;
const sourceUrl = sourcePath
  ? `https://github.com/nv-lang/nova/blob/main/${sourcePath}`
  : ghUrl;
---

<BaseLayout
  title={`${title} — спецификация — Nova`}
  description={`${title} — раздел спецификации языка Nova.`}
  canonical={`https://nv-lang.org/ru/spec/${doc.slug}/`}
  lang="ru"
  hreflangRu={`https://nv-lang.org/ru/spec/${doc.slug}/`}
  hreflangEn={`https://nv-lang.org/spec/${doc.slug}/`}
  langRuUrl={`/ru/spec/${doc.slug}/`}
  langEnUrl={`/spec/${doc.slug}/`}
  active={doc.slug === 'syntax' ? 'syntax' : 'spec'}
>
  <div class="doc-layout">
    <SpecSidebar current={`spec:${doc.slug}`} />
    <main id="main-content">
      <div class="spec-doc__meta">
        <a href="/ru/spec/">&#8592; Спецификация</a>
        <a href={ghUrl}>Источник на GitHub &#8599;</a>
      </div>
      <p class="spec-lang-note">Нормативный текст спецификации. Английская страница — <a href={`/spec/${doc.slug}/`}>informative translation</a>.</p>
      <article class="doc-content">
        <Content />
      </article>
      <PageMeta
        lang="ru"
        pagePath={`/ru/spec/${doc.slug}/`}
        sourceUrl={sourceUrl}
        sourceDate={entry.data.sourceDate}
      />
    </main>
  </div>
</BaseLayout>
