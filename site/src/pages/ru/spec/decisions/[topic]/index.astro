---
import { getCollection, render } from 'astro:content';
import BaseLayout from '@layouts/BaseLayout.astro';
import SpecSidebar from '@components/SpecSidebar.astro';
import PageMeta from '@components/PageMeta.astro';
import { TOPICS } from '@data/decisions';

export async function getStaticPaths() {
  const entries = await getCollection('decisions');
  return TOPICS.map((t) => ({
    params: { topic: t.slug },
    props: { entry: entries.find((e) => e.id === t.file)!, topic: t },
  }));
}

const { entry, topic } = Astro.props;
const { Content } = await render(entry);
const sourcePath = entry.data.sourcePath;
const sourceUrl = sourcePath
  ? `https://github.com/nv-lang/nova/blob/main/${sourcePath}`
  : undefined;
---

<BaseLayout
  title={`${topic.title} — решения по дизайну — Nova`}
  description={`D-блоки спецификации Nova по разделу «${topic.title}».`}
  canonical={`https://nv-lang.org/ru/spec/decisions/${topic.slug}/`}
  lang="ru"
  active="spec"
>
  <div class="doc-layout">
    <SpecSidebar current={`dec:${topic.slug}`} />
    <main id="main-content">
      <p style="font-size:.85rem;color:var(--fg-muted);margin-bottom:1rem;">
        <a href="/ru/spec/decisions/">← Все решения</a>
      </p>
      <p class="spec-lang-note">Нормативные решения по дизайну языка (D-блоки).</p>
      <article class="doc-content">
        <Content />
      </article>
      <PageMeta
        lang="ru"
        pagePath={`/ru/spec/decisions/${topic.slug}/`}
        sourceUrl={sourceUrl}
        sourceDate={entry.data.sourceDate}
      />
    </main>
  </div>
</BaseLayout>
