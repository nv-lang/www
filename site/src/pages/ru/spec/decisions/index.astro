---
import { getCollection } from 'astro:content';
import BaseLayout from '@layouts/BaseLayout.astro';
import SpecSidebar from '@components/SpecSidebar.astro';
import PageMeta from '@components/PageMeta.astro';
import { TOPICS, parseDBlocks } from '@data/decisions';

const entries = await getCollection('decisions');
const sections = TOPICS.map((t) => {
  const entry = entries.find((e) => e.id === t.file);
  return { topic: t, blocks: entry ? parseDBlocks(entry.body ?? '') : [] };
});
const total = sections.reduce((n, s) => n + s.blocks.length, 0);
// Дата «Обновлено» = последний коммит любого файла решений (страница
// агрегирует все D-блоки; #honest-dates — только даты коммитов источника).
const updated = sections
  .map((s) => entries.find((e) => e.id === s.topic.file)?.data.sourceDate)
  .filter((d): d is string => !!d)
  .sort()
  .at(-1);
---

<BaseLayout
  title="Решения по дизайну (D-блоки) — Nova"
  description="Все решения по дизайну языка Nova — D-блоки спецификации, сгруппированные по разделам."
  canonical="https://nv-lang.org/ru/spec/decisions/"
  lang="ru"
  active="spec"
>
  <div class="page-header">
    <div class="container--narrow">
      <h1>Решения по дизайну</h1>
      <p>
        Каждое значимое решение по языку Nova зафиксировано как <strong>D-блок</strong>:
        что, правило, почему, что отвергнуто, цена. Всего D-блоков: {total}.
      </p>
    </div>
  </div>

  <div class="doc-layout">
    <SpecSidebar current="dec:index" />
    <main id="main-content">
      <article class="doc-content">
        {sections.map((s) => (
          <section style="margin-bottom:2.25rem;">
            <h2 id={s.topic.slug}>{s.topic.title}</h2>
            <ul>
              {s.blocks.map((b) => (
                <li>
                  <a href={`/ru/spec/decisions/${s.topic.slug}/#${b.anchor}`}>
                    <strong>D{b.num}</strong> — {b.title}
                  </a>
                </li>
              ))}
            </ul>
          </section>
        ))}
      </article>
      <PageMeta
        lang="ru"
        pagePath="/ru/spec/decisions/"
        sourceUrl="https://github.com/nv-lang/nova/tree/main/spec/decisions"
        sourceDate={updated}
      />
    </main>
  </div>
</BaseLayout>
