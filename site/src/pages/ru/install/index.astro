---
import BaseLayout from '@layouts/BaseLayout.astro';
import PartialWithMeta from '@components/PartialWithMeta.astro';
import body from '@partials/ru-install-index.html?raw';
import headExtra from '@partials/ru-install-index-head.html?raw';
import { partialDate } from '@data/sourceMeta';
const updated = partialDate('ru-install-index.html');
const meta = {
  title: "Установка Nova",
  description: "Установите альфа-версию Nova Oracle 0.1.0 для Windows или Linux x86_64 и соберите первую нативную программу.",
  canonical: "https://nv-lang.org/ru/install/",
  lang: "ru" as const,
  hreflangRu: "https://nv-lang.org/ru/install/",
  hreflangEn: "https://nv-lang.org/install/",
  hreflangXDefault: "https://nv-lang.org/install/",
  ogType: "website",
  ogUrl: "https://nv-lang.org/ru/install/",
  ogTitle: "Установка Nova",
  ogDescription: "Установите альфа-версию Nova Oracle 0.1.0 для Windows или Linux x86_64 и соберите первую нативную программу.",
  twitterTitle: "Установка Nova",
  twitterDescription: "Установите альфа-версию Nova Oracle 0.1.0 для Windows или Linux x86_64 и соберите первую нативную программу.",
  langRuUrl: "/ru/install/",
  langEnUrl: "/install/",
};
---

<BaseLayout {...meta} active="install" customFooter={true}>
  <Fragment slot="head-extra" set:html={headExtra} />
  <PartialWithMeta
    body={body}
    lang="ru"
    pagePath="/ru/install/"
    partialUrl="https://github.com/nv-lang/www/blob/main/site/src/partials/ru-install-index.html"
    sourceDate={updated}
  />
</BaseLayout>
