---
// Индекс блога (ru). Список постов генерируется из коллекции blog
// (lang === 'ru'), сортировка по дате убыванию.
import { getCollection } from 'astro:content';
import BaseLayout from '@layouts/BaseLayout.astro';
import { readingMinutes } from '@data/readingTime';

const posts = (await getCollection('blog'))
  .filter((p) => p.data.lang === 'ru')
  .sort((a, b) => b.data.date.localeCompare(a.data.date));

const meta = {
  title: 'Блог — Nova',
  description: 'Блог языка Nova: объявления, заметки о дизайне и обновления о разработке.',
  canonical: 'https://nv-lang.org/ru/blog/',
  lang: 'ru' as const,
  hreflangRu: 'https://nv-lang.org/ru/blog/',
  hreflangEn: 'https://nv-lang.org/blog/',
  hreflangXDefault: 'https://nv-lang.org/blog/',
  ogType: 'website',
  ogUrl: 'https://nv-lang.org/ru/blog/',
  ogTitle: 'Блог — Nova',
  ogDescription: 'Блог языка Nova: объявления, заметки о дизайне и обновления о разработке.',
  twitterTitle: 'Блог — Nova',
  twitterDescription: 'Блог языка Nova: объявления, заметки о дизайне и обновления о разработке.',
  langRuUrl: '/ru/blog/',
  langEnUrl: '/blog/',
};
---

<BaseLayout {...meta} active="blog">
  <div class="page-header">
    <div class="container--narrow">
      <h1>Блог</h1>
      <p>Заметки о дизайне, объявления и обновления о разработке от команды Nova.</p>
    </div>
  </div>

  <main id="main-content" style="padding:2.5rem 1.5rem 5rem;">
    <div class="container--narrow">
      <ul class="blog-cards">
        {posts.map((post) => {
          const url = `/ru/blog/${post.data.slug}/`;
          const [kind, ...topics] = post.data.tags;
          const mins = post.data.readingMinutes ?? readingMinutes(post.body);
          return (
            <li class="blog-card">
              <div class="blog-card__head">
                {kind && <span class="blog-card__kind">{kind}</span>}
                <span class="blog-card__author">{post.data.author}</span>
                <span class="blog-card__date">{post.data.dateLabel}</span>
              </div>
              <a class="blog-card__title" href={url}>{post.data.title}</a>
              <div class="blog-card__meta">
                <span>{mins} мин</span>
                {topics.length > 0 && <span class="blog-card__topics">{topics.join(', ')}</span>}
              </div>
              {post.data.cover && (
                <a class="blog-card__cover" href={url} tabindex="-1" aria-hidden="true">
                  <img src={post.data.cover} alt="" width="780" height="440" loading="lazy" />
                </a>
              )}
              <p class="blog-card__excerpt">{post.data.excerpt}</p>
              <a class="blog-card__more" href={url}>Читать далее</a>
            </li>
          );
        })}
      </ul>
    </div>
  </main>
</BaseLayout>
