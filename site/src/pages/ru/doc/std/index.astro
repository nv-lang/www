---
import BaseLayout from '@layouts/BaseLayout.astro';
import PartialWithMeta from '@components/PartialWithMeta.astro';
import body from '@partials/ru-doc-std-index.html?raw';
import { partialDate } from '@data/sourceMeta';
const updated = partialDate('ru-doc-std-index.html');
const meta = {
  title: "Стандартная библиотека — Nova",
  description: "Справочник стандартной библиотеки Nova: collections, encoding, time и другие модули. Документация сгенерирована через nova doc.",
  canonical: "https://nv-lang.org/ru/doc/std/",
  lang: "ru" as const,
  hreflangRu: "https://nv-lang.org/ru/doc/std/",
  hreflangEn: "https://nv-lang.org/doc/std/",
  hreflangXDefault: "https://nv-lang.org/doc/std/",
  ogType: "website",
  ogUrl: "https://nv-lang.org/ru/doc/std/",
  ogTitle: "Стандартная библиотека — Nova",
  ogDescription: "Справочник стандартной библиотеки Nova: collections, encoding, time и другие модули. Документация сгенерирована через nova doc.",
  twitterTitle: "Стандартная библиотека — Nova",
  twitterDescription: "Справочник стандартной библиотеки Nova: collections, encoding, time и другие модули. Документация сгенерирована через nova doc.",
  langRuUrl: "/ru/doc/std/",
  langEnUrl: "/doc/std/",
};
---

<BaseLayout {...meta} active="doc">
  <PartialWithMeta
    body={body}
    lang="ru"
    pagePath="/ru/doc/std/"
    partialUrl="https://github.com/nv-lang/www/blob/main/site/src/partials/ru-doc-std-index.html"
    sourceDate={updated}
  />
</BaseLayout>
