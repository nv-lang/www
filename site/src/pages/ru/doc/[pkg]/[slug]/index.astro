---
// Страницы документации пакетов (план 241 Ф.2b): /doc/<pkg>/<slug>/.
// Источник — репозиторий самого пакета, поэтому «Edit» ведёт туда, а не в nova.
import { getCollection, render } from 'astro:content';
import BaseLayout from '@layouts/BaseLayout.astro';
import PageMeta from '@components/PageMeta.astro';
import { PACKAGE_DOCS } from '@data/packages.generated';

export async function getStaticPaths() {
  const entries = await getCollection('packages');
  const out = [];
  for (const p of PACKAGE_DOCS) {
    for (const slug of p.slugs.filter((x) => x !== 'index')) {
      const entry = entries.find((e) => e.id === `${p.pkg}/ru/${slug}`);
      const meta = p.pages?.find((x) => x.slug === slug);
      if (entry) out.push({ params: { pkg: p.pkg, slug }, props: { entry, p, slug, meta } });
    }
  }
  return out;
}

const { entry, p, slug, meta } = Astro.props;
// Заголовок страницы — её собственный H1, а не общее имя пакета.
const pageTitle = meta?.title?.ru ?? p.title.ru;
const { Content } = await render(entry);
const repo = entry.data.sourceRepo ?? p.repo;
const path = entry.data.sourcePath ?? 'README.ru.md';
const editUrl = `https://github.com/${repo}/edit/main/${path}`;
---

<BaseLayout
  title={`${pageTitle} — ${p.title.ru} — Nova`}
  description={`${pageTitle} — документация пакета ${p.title.ru}.`}
  canonical={`https://nv-lang.org/ru/doc/${p.pkg}/${slug}/`}
  hreflangRu={`https://nv-lang.org/ru/doc/${p.pkg}/${slug}/`}
  hreflangEn={`https://nv-lang.org/doc/${p.pkg}/${slug}/`}
  langRuUrl={`/ru/doc/${p.pkg}/${slug}/`}
  langEnUrl={`/doc/${p.pkg}/${slug}/`}
  lang="ru"
  active="doc"
>
  <main id="main-content" class="container--narrow" style="padding:2.5rem 0 4rem;">
    <p style="font-size:.85rem;color:var(--fg-muted);margin-bottom:1rem;">
      <a href="/ru/doc/">&#8592; Документация</a> · <a href={`https://github.com/${repo}`}>{repo}</a>
    </p>
    <article class="doc-content">
      <Content />
    </article>
    <PageMeta lang="ru" pagePath={`/ru/doc/${p.pkg}/${slug}/`} editUrl={editUrl} />
  </main>
</BaseLayout>
