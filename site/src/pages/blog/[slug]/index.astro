---
// Английская версия поста блога. Рендерит markdown из коллекции blog
// (lang === 'en'). Slug берётся из имени файла без суффикса .en.
// Подсветка кода Nova — клиентский nova-highlight.js (BaseLayout).
import { getCollection, render } from 'astro:content';
import BaseLayout from '@layouts/BaseLayout.astro';
import { readingMinutes } from '@data/readingTime';

export async function getStaticPaths() {
  const posts = await getCollection('blog');
  return posts
    .filter((p) => p.data.lang === 'en')
    .map((post) => ({
      params: { slug: post.data.slug },
      props: { post, slug: post.data.slug },
    }));
}

const { post, slug } = Astro.props;
const { Content } = await render(post);
const d = post.data;
const [, ...topics] = d.tags;
const mins = d.readingMinutes ?? readingMinutes(post.body);
const ruUrl = `/ru/blog/${slug}/`;
const enUrl = `/blog/${slug}/`;
---

<BaseLayout
  title={`${d.title} — Nova Blog`}
  description={d.description}
  canonical={d.canonical ?? `https://nv-lang.org${enUrl}`}
  lang="en"
  hreflangRu={`https://nv-lang.org${ruUrl}`}
  hreflangEn={`https://nv-lang.org${enUrl}`}
  hreflangXDefault={`https://nv-lang.org${enUrl}`}
  ogType="article"
  ogUrl={`https://nv-lang.org${enUrl}`}
  ogTitle={d.title}
  ogDescription={d.description}
  twitterTitle={d.title}
  twitterDescription={d.description}
  langRuUrl={ruUrl}
  langEnUrl={enUrl}
  active="blog"
>
  <main id="main-content" style="padding:3rem 1.5rem 5rem;">
    <div class="container--narrow">

      <p style="margin-bottom:1.5rem;"><a href="/blog/" style="color:var(--fg-muted);font-size:.88rem;">&larr; All posts</a></p>

      <article class="prose">
        <header class="post-head">
          <div class="post-byline">
            <img class="post-avatar" src="/favicon.svg" alt="" width="24" height="24" />
            <span class="post-byline__author">{d.author}</span>
            <span class="post-byline__date">{d.dateLabel}</span>
          </div>
          <h1 class="post-title">{d.title}</h1>
          <div class="post-stats">
            <span class="post-stats__time">{mins} min read</span>
            {topics.length > 0 && <span class="post-stats__topics">{topics.join(', ')}</span>}
          </div>
        </header>
        {d.cover && <img class="post-cover" src={d.cover} alt="" width="780" height="440" />}

        <Content />
      </article>

    </div>
  </main>
</BaseLayout>
