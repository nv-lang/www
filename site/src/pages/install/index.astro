---
import BaseLayout from '@layouts/BaseLayout.astro';
import PartialWithMeta from '@components/PartialWithMeta.astro';
import body from '@partials/install-index.html?raw';
import headExtra from '@partials/install-index-head.html?raw';
import { partialDate } from '@data/sourceMeta';
const updated = partialDate('install-index.html');
const meta = {
  title: "Install Nova — Get Started",
  description: "Install the Nova Oracle 0.1.0 alpha bundle for Windows or Linux x86_64 and build your first native program.",
  canonical: "https://nv-lang.org/install/",
  lang: "en" as const,
  hreflangRu: "https://nv-lang.org/ru/install/",
  hreflangEn: "https://nv-lang.org/install/",
  hreflangXDefault: "https://nv-lang.org/install/",
  ogType: "website",
  ogUrl: "https://nv-lang.org/install/",
  ogTitle: "Install Nova — Get Started",
  ogDescription: "Install the Nova Oracle 0.1.0 alpha bundle for Windows or Linux x86_64 and build your first native program.",
  twitterTitle: "Install Nova — Get Started",
  twitterDescription: "Install the Nova Oracle 0.1.0 alpha bundle for Windows or Linux x86_64 and build your first native program.",
  langRuUrl: "/ru/install/",
  langEnUrl: "/install/",
};
---

<BaseLayout {...meta} active="install" customFooter={true}>
  <Fragment slot="head-extra" set:html={headExtra} />
  <PartialWithMeta
    body={body}
    lang="en"
    pagePath="/install/"
    partialUrl="https://github.com/nv-lang/www/blob/main/site/src/partials/install-index.html"
    sourceDate={updated}
  />
</BaseLayout>
