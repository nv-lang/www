---
import BaseLayout from '@layouts/BaseLayout.astro';
import PartialWithMeta from '@components/PartialWithMeta.astro';
import body from '@partials/doc-std-index.html?raw';
import { partialDate } from '@data/sourceMeta';
const updated = partialDate('doc-std-index.html');
const meta = {
  title: "Standard Library — Nova",
  description: "Nova standard library reference: collections, encoding, time, concurrency, and more.",
  canonical: "https://nv-lang.org/doc/std/",
  lang: "en" as const,
  hreflangRu: "https://nv-lang.org/ru/doc/std/",
  hreflangEn: "https://nv-lang.org/doc/std/",
  hreflangXDefault: "https://nv-lang.org/doc/std/",
  ogType: "website",
  ogUrl: "https://nv-lang.org/doc/std/",
  ogTitle: "Standard Library — Nova",
  ogDescription: "Nova standard library reference: collections, encoding, time, concurrency, and more.",
  twitterTitle: "Standard Library — Nova",
  twitterDescription: "Nova standard library reference: collections, encoding, time, concurrency, and more.",
  langRuUrl: "/ru/doc/std/",
  langEnUrl: "/doc/std/",
};
---

<BaseLayout {...meta} active="doc">
  <PartialWithMeta
    body={body}
    lang="en"
    pagePath="/doc/std/"
    partialUrl="https://github.com/nv-lang/www/blob/main/site/src/partials/doc-std-index.html"
    sourceDate={updated}
  />
</BaseLayout>
