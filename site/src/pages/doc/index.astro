---
import BaseLayout from '@layouts/BaseLayout.astro';
import PartialWithMeta from '@components/PartialWithMeta.astro';
import body from '@partials/doc-index.html?raw';
import { partialDate } from '@data/sourceMeta';
const updated = partialDate('doc-index.html');
const meta = {
  title: "Documentation — Nova",
  description: "Nova language documentation: getting started guide, language reference, standard library, and specification.",
  canonical: "https://nv-lang.org/doc/",
  lang: "en" as const,
  hreflangRu: "https://nv-lang.org/ru/doc/",
  hreflangEn: "https://nv-lang.org/doc/",
  hreflangXDefault: "https://nv-lang.org/doc/",
  ogType: "website",
  ogUrl: "https://nv-lang.org/doc/",
  ogTitle: "Documentation — Nova",
  ogDescription: "Nova language documentation: getting started guide, language reference, standard library, and specification.",
  twitterTitle: "Documentation — Nova",
  twitterDescription: "Nova language documentation: getting started guide, language reference, standard library, and specification.",
  langRuUrl: "/ru/doc/",
  langEnUrl: "/doc/",
};
---

<BaseLayout {...meta} active="doc">
  <PartialWithMeta
    body={body}
    lang="en"
    pagePath="/doc/"
    partialUrl="https://github.com/nv-lang/www/blob/main/site/src/partials/doc-index.html"
    sourceDate={updated}
  />
</BaseLayout>
